" baseline
set nocompatible
filetype plugin indent on
syntax enable

" quality of life
set autoindent
set backspace=indent,eol,start
set cursorline
set hidden
set incsearch
set number
set relativenumber
set ruler
set showmatch
set wildmenu

" fortran
let fortran_free_source = 1
let fortran_do_enddo     = 1
let fortran_more_precise = 1
